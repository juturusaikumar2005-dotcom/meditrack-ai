{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "meditrack-ai-api"
      }
    }
  ],
  "services": {
    "meditrack-ai-api": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "cd server && npm install"
    }
  }
}
